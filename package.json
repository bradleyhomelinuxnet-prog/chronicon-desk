{
  "name": "chronicon-desk",
  "productName": "Chronicon Desk",
  "version": "0.1.0",
  "description": "All the Chronicon clocks, Phoenix 138 cycle dates, witnesses, events, Nemesis X and Nibiru in one desktop timeline.",
  "author": "bradleyhomelinuxnet-prog",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "net.homelinux.bradley.chronicondesk",
    "productName": "Chronicon Desk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "ChroniconDesk-${version}-portable.exe"
    }
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "vite": "8.3.4"
  },
  "allowScripts": {
    "electron@44.7.0": true
  }
}
